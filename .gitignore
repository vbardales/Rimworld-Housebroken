# Git is only half of what keeps the published folder clean, and the smaller half.
#
# Steam does not read .gitignore at all. SteamUGC.SetItemContent takes the junction's target
# directory as it stands on disk, with no filtering, so anything sitting in the published folder
# is published. That is what `Mod/` is for: the junction from RimWorld/Mods points there, and
# everything else in this repository - Art/, Source/, the docs, this file - stays out of reach
# by construction.

# Build intermediates.
# Directory.Build.props sends them outside the published folder: they must never end up in it,
# since Mod/ goes to the Workshop as it stands. An obj/ left there would ship the publicised
# Assembly-CSharp.dll to every subscriber.
.build/
Source/obj/
Source/bin/

# Claude Code session worktrees and local settings. A session creates its worktree in the
# current directory, so sometimes inside this one, and each is a full copy of the repository.
# Until this folder became a repository of its own the rule lived in the monorepo's .gitignore,
# a file this repository does not carry.
.claude/

# Development environments.
.vs/
.vscode/
.idea/
*.user
*.suo
*.csproj.user

# System.
Thumbs.db
desktop.ini
.DS_Store
