<Project>

  <!-- Sort le dossier intermediaire du mod. L'uploader Workshop de RimWorld envoie le
       dossier entier (SteamUGC.SetItemContent sur la racine du mod, aucune exclusion
       possible) : laisser obj/ dedans, c'est publier l'Assembly-CSharp.dll publicisee
       de 5,8 Mo, donc redistribuer le code du jeu. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\build\Housebroken\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

</Project>
